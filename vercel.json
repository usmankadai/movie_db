{
  "version": 2,
  "builds": [
    {
      "src": "server/svr.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "server/svr.js" },
    { "source": "/(.*)", "destination": "/client/$1" }
  ]
}